# Copie este arquivo para um novo chamado ".env" e cole sua chave da Anthropic.
# (o arquivo .env NAO vai para o Git — fica so no seu computador)
ANTHROPIC_API_KEY=cole-sua-chave-aqui

# Painel de reservas (pagina web da equipe).
# Defina uma senha FORTE — sem ela, o painel nao liga (o bot roda normal mesmo assim).
# Para acessar: abra http://SEU_IP:3000 e use qualquer usuario + esta senha.
PAINEL_SENHA=troque-por-uma-senha-forte
# Porta do painel (opcional, padrao 3000).
PAINEL_PORTA=3000
# Endereco do painel dentro do dominio. Vazio = raiz. Com o site institucional na raiz,
# o painel mora em /painel (https://moriizakaya.com.br/painel).
PAINEL_BASE=/painel

# ---------------------------------------------------------------------------
# API OFICIAL DO WHATSAPP (Cloud API da Meta) — migracao em andamento.
# Enquanto estes campos estiverem vazios, o webhook simplesmente NAO liga e o bot
# segue funcionando pelo Baileys, como sempre. Nada quebra por falta deles.
# ---------------------------------------------------------------------------
# Token de acesso do app (SEGREDO). No painel do app: Casos de uso -> Etapa 1.
WA_TOKEN=
# Id do numero que ENVIA as mensagens (nao e o telefone; e um numero longo do painel).
WA_PHONE_NUMBER_ID=
# Senha que NOS inventamos, so para o aperto de mao com a Meta. Pode ser qualquer
# texto longo e aleatorio — voce vai digitar o MESMO valor no painel da Meta.
WA_VERIFY_TOKEN=
# Chave secreta do app (SEGREDO). Configuracoes do app -> Basico -> Chave Secreta.
# E o que prova que quem bate no nosso webhook e mesmo a Meta.
WA_APP_SECRET=
# Porta interna do webhook (opcional, padrao 3001). O nginx publica em /webhook.
WA_WEBHOOK_PORTA=3001
